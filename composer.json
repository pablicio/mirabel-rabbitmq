{
    "name": "mirabel/rabbitmq",
    "description": "A small, framework-agnostic RabbitMQ library for PHP: declarative events and workers with retry, error queues, publisher confirms and an outbox.",
    "type": "library",
    "keywords": [
        "rabbitmq",
        "amqp",
        "messaging",
        "queue",
        "worker",
        "retry",
        "dead-letter",
        "outbox"
    ],
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Pablicio",
            "email": "pabliciotjg@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "php-amqplib/php-amqplib": "^3.7",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-pcntl": "Graceful shutdown of workers on SIGTERM/SIGINT (Linux/macOS).",
        "laravel/framework": "Optional bridge: config, environment export that survives config:cache, php artisan mirabel:work."
    },
    "autoload": {
        "psr-4": {
            "Mirabel\\RabbitMQ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mirabel\\RabbitMQ\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mirabel\\RabbitMQ\\Laravel\\MirabelServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": [
            "@putenv MIRABEL_RABBITMQ_INTEGRATION=1",
            "phpunit"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
