{
  "name": "pablicio/mirabel-rabbitmq",
  "description": "A modern, Laravel-integrated RabbitMQ library with elegant API, built on php-amqplib",
  "type": "library",
  "keywords": ["rabbitmq", "laravel", "amqp", "queue", "messaging"],
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Pablicio",
      "email": "pabliciotjg@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "php-amqplib/php-amqplib": "^3.5",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/config": "^10.0|^11.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "pestphp/pest": "^2.0",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^8.0|^9.0",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Pablicio\\MirabelRabbitmq\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pablicio\\MirabelRabbitmq\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pablicio\\MirabelRabbitmq\\MirabelRabbitmqServiceProvider"
      ],
      "aliases": {
        "RabbitMQ": "Pablicio\\MirabelRabbitmq\\Facades\\RabbitMQ"
      }
    }
  },
  "scripts": {
    "test": "pest",
    "test-coverage": "pest --coverage",
    "analyse": "phpstan analyse src tests --level=5"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
